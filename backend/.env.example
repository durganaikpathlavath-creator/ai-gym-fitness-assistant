DATABASE_URL=postgresql://username:password@localhost:5432/ai_gym

JWT_SECRET_KEY=generate-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional LLM API Keys for AI Dietician / Conversational Guidance
# If omitted, system seamlessly runs high-accuracy deterministic expert fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Configuration (comma-separated list of allowed origins)
# Defaults include Vercel production and localhost; set this on Render to add/override origins
CORS_ORIGINS=https://ai-gym-fitness-assistant-lsk5ipcd6-pathalavath.vercel.app,http://localhost:3000